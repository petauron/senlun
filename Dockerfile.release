# Package the verified native release archives; compilation happens in the binaries job.
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime
ARG TARGETARCH
ARG SENLUN_BUILD_GIT_HASH=unknown
LABEL org.opencontainers.image.source="https://github.com/petauron/senlun" \
      org.opencontainers.image.description="Self-hosted node monitoring with an outbound-only Agent" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.revision="${SENLUN_BUILD_GIT_HASH}"
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 senlun \
    && useradd --uid 65532 --gid senlun --system --home-dir /var/lib/senlun --shell /usr/sbin/nologin senlun \
    && install --directory --owner senlun --group senlun --mode 0700 /var/lib/senlun
COPY ${TARGETARCH}/senlun-service /usr/local/bin/senlun-service
COPY ${TARGETARCH}/senlun-agent /usr/local/bin/senlun-agent
COPY ${TARGETARCH}/LICENSE ${TARGETARCH}/NOTICE ${TARGETARCH}/RUST_THIRD_PARTY_LICENSES.html ${TARGETARCH}/RUST_STDLIB_LICENSES.html /usr/share/doc/senlun/
COPY ${TARGETARCH}/web/THIRD_PARTY_NOTICES.md ${TARGETARCH}/web/LICENSE.* /usr/share/doc/senlun/web/
COPY ${TARGETARCH}/web/THIRD_PARTY_LICENSES.md /usr/share/doc/senlun/web/
USER 65532:65532
WORKDIR /var/lib/senlun
ENV SENLUN_LISTEN=0.0.0.0:8080 \
    SENLUN_ALLOW_PUBLIC_LISTEN=true \
    SENLUN_DATABASE_PATH=/var/lib/senlun/store/senlun.db
VOLUME ["/var/lib/senlun"]
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/senlun-service"]
CMD ["migrate-and-serve"]

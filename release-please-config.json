{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "ec834434d168be5dce71a20025bce509ade7d68d",
  "packages": {
    ".": {
      "release-type": "simple",
      "version-file": "version.txt",
      "package-name": "senlun",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "draft": true,
      "versioning": "default",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'senlun-protocol' || @.name.value == 'senlun-service')].version"
        },
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "web/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "web/package-lock.json",
          "jsonpath": "$.packages[''].version"
        }
      ]
    },
    "crates": {
      "release-type": "simple",
      "version-file": "senlun-agent/version.txt",
      "changelog-path": "senlun-agent/CHANGELOG.md",
      "package-name": "senlun-agent",
      "component": "senlun-agent",
      "exclude-paths": ["crates/senlun-service", "crates/senlun-agent/tests"],
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "draft": true,
      "versioning": "default",
      "extra-files": [
        {
          "type": "toml",
          "path": "senlun-agent/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'senlun-agent')].version"
        }
      ]
    }
  }
}

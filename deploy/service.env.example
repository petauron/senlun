SENLUN_LISTEN=127.0.0.1:8080
SENLUN_DATABASE_PATH=/var/lib/senlun/senlun-store/senlun.db
# Persist the derived sibling senlun.metrics.db together with senlun.db.
SENLUN_RETENTION_DAYS=7
SENLUN_OFFLINE_AFTER_SECONDS=90
SENLUN_MAX_NODES=100
# Per-file bound for each database, excluding WAL files and backups.
SENLUN_MAX_DATABASE_BYTES=2147483648
# Exact browser-facing HTTPS origin, also used for OAuth callback and CSRF checks.
SENLUN_PUBLIC_URL=https://senlun.example.com
# Optional GitHub OAuth: configure all three together; allow only this numeric account ID.
# SENLUN_GITHUB_CLIENT_ID=
# SENLUN_GITHUB_CLIENT_SECRET_FILE=/etc/senlun/github-client-secret
# SENLUN_GITHUB_ALLOWED_USER_ID=
# Set true only when TLS is terminated by a reverse proxy or a private network is enforced.
SENLUN_ALLOW_PUBLIC_LISTEN=false
# Optional exact reverse-proxy peer IP, only after configuring it to discard
# client-provided X-Real-IP and set one verified visitor address.
# SENLUN_TRUSTED_PROXY_IP=127.0.0.1

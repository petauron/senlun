[Unit]
Description=Senlun outbound monitoring agent
Documentation=https://github.com/petauron/senlun
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=senlun-agent
Group=senlun-agent
EnvironmentFile=/etc/senlun/agent.env
ExecStart=/usr/local/bin/senlun-agent
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
StateDirectory=senlun-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/senlun-agent
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

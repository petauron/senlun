[Unit]
Description=Senlun monitoring service
Documentation=https://github.com/petauron/senlun
After=network.target

[Service]
Type=simple
User=senlun
Group=senlun
EnvironmentFile=/etc/senlun/service.env
ExecStart=/usr/local/bin/senlun-service serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=senlun
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/senlun
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

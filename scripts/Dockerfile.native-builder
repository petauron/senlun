# The caller supplies the same reviewed, digest-pinned GNU Rust base used for
# the Service. Only the Agent gains a static musl target; no compatibility libc.
ARG RUST_BASE
FROM ${RUST_BASE}
ARG MUSL_TARGET
RUN case "$MUSL_TARGET" in x86_64-unknown-linux-musl|aarch64-unknown-linux-musl) ;; *) exit 1 ;; esac \
 && apt-get update \
 && apt-get install -y --no-install-recommends musl-tools binutils \
 && rm -rf /var/lib/apt/lists/* \
 && rustup target add --toolchain 1.98.0 "$MUSL_TARGET"

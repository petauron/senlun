# Senlun Service. Enrollment tokens are created with the local admin CLI.
SENLUN_LISTEN=127.0.0.1:8080
SENLUN_DATABASE_PATH=senlun.db
# The derived sibling senlun.metrics.db must be persisted and backed up with senlun.db.
SENLUN_RETENTION_DAYS=7
SENLUN_OFFLINE_AFTER_SECONDS=90
SENLUN_MAX_NODES=100
# Per-file limit for BOTH databases: default total allowance is 4 GiB, excluding WAL/backups.
SENLUN_MAX_DATABASE_BYTES=2147483648
# Optional: required before configuring external HTTP traffic sources.
# File contents: exactly 32 random bytes; permissions 0600. Preserve with database backups.
# SENLUN_TRAFFIC_KEY_FILE=/var/lib/senlun/traffic-credential.key
# Exact browser origin; HTTPS is required except for local loopback development.
SENLUN_PUBLIC_URL=http://127.0.0.1:8080
# GitHub login is off unless all three settings are explicitly configured.
# SENLUN_GITHUB_CLIENT_ID=
# SENLUN_GITHUB_CLIENT_SECRET_FILE=./github-client-secret
# SENLUN_GITHUB_ALLOWED_USER_ID=
# Required only for a deliberate non-loopback bind. Terminate TLS in front.
SENLUN_ALLOW_PUBLIC_LISTEN=false
# Optional exact reverse-proxy peer IP. The proxy must overwrite X-Real-IP
# with its verified client address. Leave unset without that header policy.
# SENLUN_TRUSTED_PROXY_IP=127.0.0.1

# Senlun Agent. Supply exactly one token source only for first enrollment.
SENLUN_SERVICE_URL=http://127.0.0.1:8080
SENLUN_NODE_NAME=example-node
# Manual country code (e.g. US, SG), or empty for default automatic discovery.
SENLUN_NODE_REGION=
# Default GeoJS sees public egress IP and Agent version, not credentials/metrics.
# Set disabled to opt out, or ipinfo to change provider. Manual region wins.
SENLUN_GEOIP_PROVIDER=geojs
SENLUN_NODE_GROUP=default
SENLUN_NODE_VIRTUALIZATION=
SENLUN_INTERVAL_SECONDS=3
SENLUN_CREDENTIALS_PATH=./agent-credentials.json
# Preferred for production; the file must be mode 0600 and can be removed after enrollment.
SENLUN_ENROLLMENT_TOKEN_FILE=./enrollment-token
# SENLUN_ENROLLMENT_TOKEN=replace-with-the-short-lived-token
# Optional exact comma-separated filters:
# SENLUN_DISK_MOUNT_POINTS=/,/data
# SENLUN_NETWORK_INTERFACES=eth0
